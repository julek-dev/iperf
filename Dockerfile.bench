# syntax=docker/dockerfile:1.6
#
# Self-contained reproducer for iperf's DTLS 1.2 loopback benchmark.
#
# The build stage compiles three SSL stacks (distro OpenSSL 3,
# OpenSSL 1.1.1w, wolfSSL with Intel ASM) and three matching iperf3
# variants.  The runtime stage keeps just the binaries and the
# benchmark script; no source trees, no toolchain.
#
# Build (from the iperf repository root):
#     docker build -f Dockerfile.bench -t iperf-dtls-bench .
#
# Full sweep (pinned single-core + -P 1/2/4/8, 30 s per row):
#     docker run --rm iperf-dtls-bench
#
# Quick sanity run:
#     docker run --rm -e DUR=5 -e PARALLELS="1 4" iperf-dtls-bench
#
# Just the multi-thread sweep:
#     docker run --rm -e SKIP_PINNED=1 iperf-dtls-bench
#
# Persist the per-run JSON:
#     docker run --rm -v "$PWD/out:/opt/bench/results" iperf-dtls-bench
#
# All benchmarks happen on the container's loopback interface, so no
# special networking is required.  The host must be x86_64 with
# AES-NI (the wolfSSL build is Intel-specific); the image is pinned
# to linux/amd64 for that reason.
#
# ---------- stage 1: build everything --------------------------------

FROM --platform=linux/amd64 ubuntu:24.04 AS build

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git \
        build-essential autoconf automake libtool pkg-config \
        libssl-dev openssl python3 \
    && rm -rf /var/lib/apt/lists/*

# --- wolfSSL with full Intel-ASM flag set ---
# Pull from upstream.  Pin with --build-arg WOLFSSL_REF=v5.7.4-stable (or
# any other tag/commit) if you need byte-reproducible results.
ARG WOLFSSL_REPO=https://github.com/wolfSSL/wolfssl.git
ARG WOLFSSL_REF=master
RUN set -eux; \
    git clone --depth 1 --branch "${WOLFSSL_REF}" "${WOLFSSL_REPO}" /src/wolfssl; \
    cd /src/wolfssl; \
    ./autogen.sh; \
    ./configure --prefix=/opt/wolfssl \
        --enable-opensslall --enable-opensslextra --enable-dtls \
        --enable-aesgcm --enable-aesgcm-stream \
        --enable-aesni --enable-aesni-with-avx --enable-intelasm \
        --enable-sp --enable-sp-asm --enable-intelrand \
        --disable-harden --enable-sha384 --enable-sha512; \
    make -j"$(nproc)"; \
    make install; \
    cd / && rm -rf /src/wolfssl

# --- OpenSSL 1.1.1w ---
ARG OPENSSL11_URL=https://github.com/openssl/openssl/releases/download/OpenSSL_1_1_1w/openssl-1.1.1w.tar.gz
RUN set -eux; \
    mkdir -p /src/openssl11; cd /src/openssl11; \
    curl -sSLO "${OPENSSL11_URL}"; \
    tar -xzf openssl-1.1.1w.tar.gz; \
    cd openssl-1.1.1w; \
    ./config --prefix=/opt/openssl11 --openssldir=/opt/openssl11/ssl shared; \
    make -j"$(nproc)"; \
    make install_sw; \
    cd / && rm -rf /src/openssl11

# --- three iperf3 variants (distro OpenSSL 3, OpenSSL 1.1.1w, wolfSSL) ---
COPY . /src/iperf
RUN set -eux; \
    cd /src/iperf; \
    ./bootstrap.sh >/dev/null 2>&1; \
    mkdir -p \
        /opt/bench/bin/openssl3-lib \
        /opt/bench/bin/openssl11-lib \
        /opt/bench/bin/wolfssl-lib; \
    \
    make distclean >/dev/null 2>&1 || true; \
    ./configure --with-openssl=/usr >/dev/null; \
    make -j"$(nproc)" >/dev/null; \
    cp src/.libs/iperf3             /opt/bench/bin/iperf3-openssl3; \
    cp src/.libs/libiperf.so.0.0.0  /opt/bench/bin/openssl3-lib/libiperf.so.0; \
    \
    make distclean >/dev/null 2>&1; \
    ./configure --with-openssl=/opt/openssl11 >/dev/null; \
    make -j"$(nproc)" >/dev/null; \
    cp src/.libs/iperf3             /opt/bench/bin/iperf3-openssl11; \
    cp src/.libs/libiperf.so.0.0.0  /opt/bench/bin/openssl11-lib/libiperf.so.0; \
    \
    make distclean >/dev/null 2>&1; \
    ./configure --with-wolfssl=/opt/wolfssl >/dev/null; \
    make -j"$(nproc)" >/dev/null; \
    cp src/.libs/iperf3             /opt/bench/bin/iperf3-wolfssl; \
    cp src/.libs/libiperf.so.0.0.0  /opt/bench/bin/wolfssl-lib/libiperf.so.0; \
    \
    install -m 755 scripts/benchmark-dtls.sh /usr/local/bin/benchmark-dtls.sh; \
    cd / && rm -rf /src/iperf

# --- throwaway DTLS cert baked into the image ---
RUN openssl req -x509 -nodes -newkey rsa:2048 \
        -keyout /opt/bench/key.pem -out /opt/bench/cert.pem \
        -days 3650 -subj '/CN=iperf-dtls-bench' >/dev/null 2>&1

# ---------- stage 2: slim runtime ------------------------------------

FROM --platform=linux/amd64 ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        libssl3 python3 util-linux ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/wolfssl   /opt/wolfssl
COPY --from=build /opt/openssl11 /opt/openssl11
COPY --from=build /opt/bench     /opt/bench
COPY --from=build /usr/local/bin/benchmark-dtls.sh /usr/local/bin/benchmark-dtls.sh

ENV BENCH_DIR=/opt/bench \
    WOLFSSL_PREFIX=/opt/wolfssl \
    OPENSSL11_PREFIX=/opt/openssl11 \
    DUR=30 \
    BLKSZ=1200 \
    PARALLELS="1 2 4 8"

# Mount point for the per-run JSON if you want to pull it out.
VOLUME ["/opt/bench/results"]

ENTRYPOINT ["/usr/local/bin/benchmark-dtls.sh"]
